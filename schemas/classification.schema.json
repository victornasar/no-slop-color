{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://no-slop-color.local/schemas/classification.schema.json",
  "title": "Classification files",
  "$defs": {
    "status": { "enum": ["provisional", "adopted", "retired"] },
    "basis": {
      "enum": ["measured", "hybrid", "curated"],
      "description": "measured: a numeric test decides. hybrid: a test suggests and a curator confirms. curated: judgement only."
    },
    "entry": {
      "type": "object",
      "required": ["id", "label", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z-]*$" },
        "label": { "type": "string" },
        "status": { "$ref": "#/$defs/status" },
        "basis": { "$ref": "#/$defs/basis" },
        "definition": { "type": "string" },
        "test": { "type": "string" },
        "params": { "type": "object" },
        "notes": { "type": "string" }
      }
    },
    "primaryFile": {
      "type": "object",
      "required": ["schemaVersion", "status", "unit", "measurements", "models"],
      "properties": {
        "$schema": { "type": "string" },
        "schemaVersion": { "type": "string" },
        "status": { "type": "string" },
        "unit": { "type": "string" },
        "measurements": { "type": "object" },
        "models": {
          "type": "object",
          "required": ["twoAxis", "displayLabels"],
          "properties": {
            "twoAxis": {
              "description": "The primary classification.",
              "type": "object",
              "required": ["foundation", "structure"],
              "properties": {
                "foundation": { "type": "array", "items": { "$ref": "#/$defs/entry" } },
                "structure": { "type": "array", "items": { "$ref": "#/$defs/entry" } },
                "unresolved": { "type": "string" }
              }
            },
            "displayLabels": {
              "description": "Display names derived from the two axes and the Vibrant tag.",
              "type": "object",
              "required": ["labels"],
              "properties": {
                "labels": { "type": "array", "minItems": 1, "items": { "allOf": [{ "$ref": "#/$defs/entry" }, { "required": ["derivation"], "properties": { "derivation": { "type": "string" } } }] } }
              }
            }
          }
        }
      }
    },
    "secondaryFile": {
      "type": "object",
      "required": ["schemaVersion", "status", "dimensions"],
      "properties": {
        "$schema": { "type": "string" },
        "schemaVersion": { "type": "string" },
        "status": { "type": "string" },
        "dimensions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "label", "classifications"],
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "notes": { "type": "string" },
              "classifications": {
                "type": "array",
                "minItems": 1,
                "items": { "allOf": [{ "$ref": "#/$defs/entry" }, { "required": ["basis", "definition"] }] }
              }
            }
          }
        }
      }
    }
  }
}
