{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://no-slop-color.local/schemas/library.schema.json",
  "title": "Curated library",
  "description": "Built by tools/build.mjs from library/source/*.json.",
  "type": "object",
  "required": ["schemaVersion", "status", "count", "primaries", "coverage", "directions"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "string" },
    "status": { "enum": ["provisional", "adopted"] },
    "count": { "type": "integer", "minimum": 1 },
    "primaries": { "type": "object", "additionalProperties": { "type": "integer" } },
    "coverage": { "type": "object", "description": "Directions per domain id.", "additionalProperties": { "type": "integer" } },
    "directions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          { "$ref": "direction.schema.json" },
          { "required": ["status", "curation", "use_for", "watch_out"] }
        ]
      }
    }
  }
}
