{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://no-slop-color.local/schemas/direction.schema.json",
  "title": "Color direction",
  "description": "One usable color direction. Its identity is a classified ground and figure pair. Everything else explains or applies it.",
  "type": "object",
  "required": ["id", "name", "classification", "reasoning", "usage", "accessibility"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "classification": { "$ref": "pair-classification.schema.json" },
    "reasoning": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/reason" }
    },
    "usage": {
      "type": "object",
      "required": ["assignments", "do", "avoid"],
      "additionalProperties": false,
      "properties": {
        "assignments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["element", "color"],
            "additionalProperties": false,
            "properties": {
              "element": { "type": "string" },
              "color": { "$ref": "#/$defs/roleRef" },
              "on": { "$ref": "#/$defs/roleRef" }
            }
          }
        },
        "do": { "type": "array", "items": { "type": "string" } },
        "avoid": { "type": "array", "items": { "type": "string" } }
      }
    },
    "accessibility": {
      "type": "object",
      "required": ["standard", "pairs", "notes"],
      "additionalProperties": false,
      "properties": {
        "standard": { "const": "WCAG 2.2 contrast computed from sRGB HEX" },
        "pairs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["foreground", "background", "intended_use", "ratio", "required", "passes"],
            "additionalProperties": false,
            "properties": {
              "foreground": { "$ref": "#/$defs/roleRef" },
              "background": { "$ref": "#/$defs/roleRef" },
              "intended_use": { "enum": ["body-text", "large-text", "ui-component", "decorative"] },
              "ratio": { "type": "number", "minimum": 1, "maximum": 21, "description": "Rounded down to two decimals." },
              "required": { "type": ["number", "null"] },
              "passes": { "type": "boolean", "description": "Evaluated on the unrounded ratio." }
            }
          }
        },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "roleRef": {
      "description": "A color in this direction by role: the pair, the accent, or a derived color such as tint-2 or shade-1.",
      "type": "string",
      "pattern": "^(ground|figure|accent|text|text-muted|tint-[1-9]|shade-[1-9])$"
    },
    "reason": {
      "type": "object",
      "required": ["claim", "kind"],
      "additionalProperties": false,
      "properties": {
        "claim": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": ["measured", "convention", "cultural-context", "interpretation"],
          "description": "measured: computed from the colors. convention: established design practice. cultural-context: a sourced statement about a tradition or place. interpretation: a design judgement offered as one."
        },
        "sources": { "type": "array", "items": { "type": "string", "format": "uri" } }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "cultural-context" } } },
          "then": { "required": ["sources"], "properties": { "sources": { "minItems": 1 } } }
        }
      ]
    }
  }
}
