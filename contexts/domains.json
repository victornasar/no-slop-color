{
  "$schema": "../schemas/domain.schema.json",
  "schemaVersion": "0.1.0",
  "status": "extensible: the coverage set the system must serve",
  "rule": "Domains route context questions and measure coverage. They carry no colors, hues, palettes or meanings, and a domain must never select a color by itself.",
  "groups": [
    {
      "id": "fashion-and-luxury",
      "label": "Fashion and luxury",
      "differentiators": [
        "Is the brand defined by seasons or by permanent pieces?",
        "Does the product or the brand supply most of the color?",
        "Who is it positioned against?"
      ]
    },
    {
      "id": "sport-and-gaming",
      "label": "Sport and gaming",
      "differentiators": [
        "Does it represent a team, a league, a product or a community?",
        "Are there existing team or title colors?",
        "Will it mostly appear on screens, kits or broadcast?"
      ]
    },
    {
      "id": "entertainment-and-events",
      "label": "Entertainment and events",
      "differentiators": [
        "Is the identity permanent or does it change each edition?",
        "Will it be seen mostly at night, outdoors or on screens?",
        "Does it need to work on large-format print or wayfinding?"
      ]
    },
    {
      "id": "food-and-hospitality",
      "label": "Food and hospitality",
      "differentiators": [
        "What are the origin, ingredients or cuisine?",
        "What does the physical space look like?",
        "How much will photography carry the color?",
        "Does it need to work on packaging?"
      ]
    },
    {
      "id": "beauty-and-adornment",
      "label": "Beauty and adornment",
      "differentiators": [
        "Does product color need to read accurately beside the brand color?",
        "Is the positioning clinical, sensorial or expressive?",
        "What range of skin tones must the imagery support?"
      ]
    },
    {
      "id": "consumer-and-retail",
      "label": "Consumer and retail",
      "differentiators": [
        "Who buys it, and is that the same person who uses it?",
        "Must it stand out on a shelf or in a product grid?",
        "Does the catalog already contain many colors?"
      ]
    },
    {
      "id": "technology-and-software",
      "label": "Technology and software",
      "differentiators": [
        "Is this a dense, all-day interface or a marketing site?",
        "Does it need light and dark themes?",
        "Does the interface need status and data-visualization colors?"
      ]
    },
    {
      "id": "finance",
      "label": "Finance",
      "differentiators": [
        "Is it consumer-facing or institutional?",
        "Which regulatory or accessibility requirements apply?",
        "Is the aim to fit the category or to challenge it?"
      ]
    },
    {
      "id": "health-and-wellbeing",
      "label": "Health and wellbeing",
      "differentiators": [
        "Is the audience clinicians, patients or consumers?",
        "Is the context clinical, stressful or leisurely?",
        "Are there accessibility or regulatory constraints?"
      ]
    },
    {
      "id": "sustainability-and-land",
      "label": "Sustainability and land",
      "differentiators": [
        "Is the claim about material, process, place or outcome?",
        "Would the expected green make the brand indistinguishable from its category?",
        "Does it need to work outdoors or on natural materials?"
      ]
    },
    {
      "id": "place-and-built-environment",
      "label": "Place and built environment",
      "differentiators": [
        "Which specific place or material is involved?",
        "Will photography dominate?",
        "Is the audience local or international?"
      ]
    },
    {
      "id": "mobility-and-industry",
      "label": "Mobility and industry",
      "differentiators": [
        "Must it work on vehicles, signage or safety equipment?",
        "Do safety color standards apply?",
        "Is it consumer-facing or business-to-business?"
      ]
    },
    {
      "id": "institutions-and-knowledge",
      "label": "Institutions and knowledge",
      "differentiators": [
        "Which community, tradition and locale does it serve?",
        "What is the age of the audience?",
        "Is there an existing crest, archive or visual history?",
        "How much long-form reading is involved?"
      ]
    },
    {
      "id": "corporate-and-services",
      "label": "Corporate and services",
      "differentiators": [
        "What separates this firm from its direct peers?",
        "How much of the work is documents and presentations?",
        "Must the system span several sub-brands?"
      ]
    },
    {
      "id": "media-and-publishing",
      "label": "Media and publishing",
      "differentiators": [
        "Must the interface stay quiet so content can lead?",
        "Does the color need to change by title, section or season?",
        "Is reading or viewing the main activity?"
      ]
    },
    {
      "id": "creative-and-personal",
      "label": "Creative and personal",
      "differentiators": [
        "Should the work or the frame be most prominent?",
        "Does the owner have an existing visual signature?",
        "How often will the identity change?"
      ]
    },
    {
      "id": "marketing",
      "label": "Marketing",
      "differentiators": [
        "Is the color campaign-specific or tied to a parent brand?",
        "Which channels and formats matter most?",
        "How long will it run?"
      ]
    }
  ],
